[Unit]
Description=Automotive Colab experiment controller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/git/automotive-recsys
ExecStart=%h/git/automotive-recsys/.venv/bin/python -u %h/git/automotive-recsys/scripts/colab_campaign.py --config %h/git/automotive-recsys/results/campaigns/current.json
Restart=on-failure
RestartSec=60
UMask=0077
Environment=COLAB_CLI_REQUEST_TIMEOUT=120
MemoryMax=1G
CPUQuota=50%
StandardOutput=append:%h/git/automotive-recsys/results/campaigns/controller-service.log
StandardError=append:%h/git/automotive-recsys/results/campaigns/controller-service.log

[Install]
WantedBy=default.target
